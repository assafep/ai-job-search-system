{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/index/mcp"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/index/mcp"
    },
    {
      "source": "/health",
      "destination": "/api/index/health"
    },
    {
      "source": "/api/health",
      "destination": "/api/index/health"
    },
    {
      "source": "/cron/dispatch",
      "destination": "/api/index/cron/dispatch"
    },
    {
      "source": "/api/cron/dispatch",
      "destination": "/api/index/cron/dispatch"
    }
  ]
}
