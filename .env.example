# GDTQ single-writer runtime. Never commit live secrets or config/runtime.json.
GOOGLE_ACCESS_TOKEN=
# Prefer the refresh-token trio for a long-running process:
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Read-only grants written by the Gmail and Calendar onboard stages.
# They do not replace GOOGLE_REFRESH_TOKEN.
# GOOGLE_GMAIL_REFRESH_TOKEN=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# Or authorized service-account JSON with appropriate Drive permissions:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Résumé path inside the Drive folder. Same GOOGLE_ prefix as the account credentials.
GOOGLE_RESUME_DRIVE_PATH=Applicant/resume.pdf
GOOGLE_API_TIMEOUT_SECONDS=30
DRIVE_METADATA_CACHE_SECONDS=60
JOURNAL_READ_CACHE_SECONDS=5
# Model provider: grok, openai, anthropic, gemini, or an OpenAI-compatible base URL.
AJSS_LLM_PROVIDER=
AJSS_LLM_API_KEY=
AJSS_LLM_MODEL=
# Older names still select OpenAI or Grok when AJSS_LLM_PROVIDER is unset.
# OPENAI_API_KEY=
# XAI_API_KEY=
AJSS_GDTQ_DB=var/ajss-gdtq.sqlite3
AJSS_SKILL_THRESHOLD=0
# Default off: opt in to email/calendar/research/report polling.
AJSS_GDTQ_ENABLE_OBSERVERS=0
AJSS_REPORT_RECIPIENT=
# Default off: send drafts only without explicit authorization.
AJSS_GMAIL_ALLOW_SEND=0
# ATS read tuning, optional:
POSTING_REQUEST_TIMEOUT_SECONDS=12
POSTING_FETCH_BUDGET_SECONDS=25
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Processed-applications Postgres URL. The worker reads DATABASE_URL, then AJSS_DATABASE_URL.
# A database you already started: set AJSS_DATABASE_URL and leave DATABASE_URL empty.
# Neon created in Vercel writes DATABASE_URL. Either name is enough. Never commit the value.
AJSS_DATABASE_URL=
DATABASE_URL=
# For offline tests only; never use this fallback on Vercel.
AJSS_ALLOW_LOCAL_SQLITE=0
