# Credentials are not stored in config/runtime.json.
GOOGLE_ACCESS_TOKEN=
# For long-running deployments, use refresh credentials instead of a static token.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to use Google Drive after onboarding; set memory for local-only tests.
REPOSITORY_BACKEND=
PERSISTENCE_API_URL=http://127.0.0.1:8080
PERSISTENCE_API_TOKEN=
# MCP OAuth issuer: canonical public HTTPS origin, without /mcp.
# The Vercel deployer sets this from the production URL. OAuth also needs the database.
# MCP requires a service token even when local REST access is unauthenticated.
AJSS_MCP_ISSUER=
# Bound stalled calls; serialized storage must not wait indefinitely.
PERSISTENCE_TIMEOUT_SECONDS=45
GOOGLE_API_TIMEOUT_SECONDS=30
# Reuse recent reads; journal mutations always refresh before writing.
JOURNAL_READ_CACHE_SECONDS=5
DRIVE_METADATA_CACHE_SECONDS=60
# Operational state is saved immediately; only report checkpoints are batched.
REPORT_CHECKPOINT_SECONDS=60
REPORT_CHECKPOINT_POSTINGS=10
POSTING_REQUEST_TIMEOUT_SECONDS=12
POSTING_FETCH_BUDGET_SECONDS=25
# Optional activity log shared by the persistence API and the orchestrator.
# Overrides activity_log in config/runtime.json. Leave disabled to write nothing.
ACTIVITY_LOG_ENABLED=
ACTIVITY_LOG_FILE=
# Optional persistence API request log. Overrides api_log in config/runtime.json.
# Leave disabled so the API writes nothing to the terminal or to a file.
API_LOG_ENABLED=
API_LOG_FILE=
# Optional durable scheduler bookkeeping; application state remains in Drive.
WORKLOAD_REGISTRY_PATH=
WORKLOAD_MAX_ATTEMPTS=3
# Optional durable human-approval bookkeeping.
APPROVAL_REGISTRY_PATH=
# Optional provider override for preparation, auto-apply, correspondence, and
# interview. The default is Codex CLI, authenticated with `codex --login`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_PROVIDER=
# Scout uses this local coding-agent command. It does not select a model.
# Set CODING_AGENT_MODEL only to override the agent's own default.
# Known commands: grok, codex. DISCOVERY_PROVIDER can replace the launcher
# with another module:attribute provider.
CODING_AGENT=
CODING_AGENT_MODEL=
# URL reads use low reasoning unless this is set. Leave empty for that default.
CODING_AGENT_REASONING=
CODING_AGENT_TIMEOUT_SECONDS=300
DISCOVERY_PROVIDER=
# Optional remote xAI API. Discovery ignores XAI_API_KEY even when it is set.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_TIMEOUT_SECONDS=300
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_TIMEOUT_SECONDS=300
# Optional overrides; otherwise values are loaded from config/runtime.json.
GOOGLE_INTERVIEW_JOURNAL_URL=
GOOGLE_ARTIFACT_ROOT_URL=
# Optional root-relative parent for application folders, e.g. applications
GOOGLE_APPLICATION_ROOT_PATH=
# Public Greenhouse board tokens mapped to company names, for example:
# {"example":"Example Systems","acme":"Acme Corp"}
GREENHOUSE_BOARDS=
# Broad job-search source; obtain credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=il
# Jobicy is public and requires no credentials. Use source_names=["jobicy"].
