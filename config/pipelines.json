{
  "poll_seconds": 2,
  "scan_seconds": 60,
  "event_poll_seconds": 60,
  "discovery_seconds": 60,
  "discovery_workers": 7,
  "discovery_sources": [
    "freehire",
    "jobicy",
    "greenhouse",
    "ashby",
    "comeet",
    "lever",
    "himalayas",
    "smartrecruiters"
  ],
  "pipelines": {
    "bookmark": {
      "states": [
        "Discovered"
      ],
      "agent": "read-posting",
      "workers": 4,
      "routes": {
        "read": "Bookmarked",
        "read_failure": "Manual Apply Required",
        "system_error": "Dead Letters Queue"
      }
    },
    "validate": {
      "states": [
        "Bookmarked"
      ],
      "agent": "validate",
      "workers": 4,
      "routes": {
        "validated": "Validated",
        "invalidated": null,
        "duplicate": "Duplicate",
        "system_error": "Dead Letters Queue"
      }
    },
    "prepare": {
      "states": [
        "Validated"
      ],
      "agent": "application",
      "workers": 4,
      "routes": {
        "prepared": "Prepared",
        "failed": "Manual Apply Required",
        "duplicate": "Duplicate",
        "system_error": "Dead Letters Queue"
      }
    },
    "submit": {
      "states": [
        "Prepared"
      ],
      "agent": "auto-apply",
      "workers": 4,
      "routes": {
        "submitted": "Applied",
        "failed": "Manual Apply Required",
        "unconfirmed": "Manual Apply Required",
        "waiting": null,
        "system_error": "Dead Letters Queue"
      }
    },
    "correspondence": {
      "states": [
        "Prepared",
        "Manual Apply Required",
        "Applied",
        "Interviewing"
      ],
      "event_type": "incoming_email",
      "agent": "correspondence",
      "workers": 4,
      "routes": {
        "processed": null,
        "confirmed": "Applied",
        "interview": "Interviewing",
        "rejected": "Rejected",
        "offered": "Offer",
        "failed": null,
        "system_error": "Dead Letters Queue"
      }
    },
    "interview": {
      "states": [
        "Applied",
        "Interviewing"
      ],
      "event_type": "calendar_event",
      "agent": "interview-prep",
      "workers": 4,
      "routes": {
        "prepared": "Interviewing",
        "failed": null,
        "system_error": "Dead Letters Queue"
      },
      "event_poll_seconds": 86400
    }
  }
}
