{
  "poll_seconds": 2,
  "scan_seconds": 5,
  "event_poll_seconds": 60,
  "discovery_seconds": 86400,
  "discovery_sources": ["freehire", "jobicy"],
  "pipelines": {
    "scout": {
      "states": ["Replay"],
      "agent": "job-discovery",
      "workers": 0,
      "routes": {"accepted": "Bookmarked", "declined": null, "failed": "Manual Apply Required", "duplicate": "Duplicate", "system_error": "Dead Letters Queue"}
    },
    "preparation": {
      "states": ["Bookmarked"],
      "agent": "application",
      "workers": 0,
      "routes": {"prepared": "Ready for Auto-Apply", "failed": "Manual Apply Required", "duplicate": "Duplicate", "system_error": "Dead Letters Queue"}
    },
    "auto-apply": {
      "states": ["Ready for Auto-Apply"],
      "agent": "auto-apply",
      "workers": 0,
      "routes": {"submitted": "Applied", "failed": "Manual Apply Required", "unconfirmed": "Manual Apply Required", "waiting": null, "system_error": "Dead Letters Queue"}
    },
    "correspondence": {
      "states": ["Applied", "Interviewing"],
      "event_type": "incoming_email",
      "agent": "correspondence",
      "workers": 0,
      "routes": {"processed": null, "interview": "Interviewing", "rejected": "Rejected", "offered": "Offer", "failed": null, "system_error": "Dead Letters Queue"}
    },
    "interview": {
      "states": ["Applied", "Interviewing"],
      "event_type": "calendar_event",
      "agent": "interview-prep",
      "workers": 0,
      "routes": {"prepared": "Interviewing", "failed": null, "system_error": "Dead Letters Queue"}
    }
  }
}
