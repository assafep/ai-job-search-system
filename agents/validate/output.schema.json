{
  "type": "object",
  "required": ["is_match", "company", "role", "posting_url"],
  "properties": {
    "company": {
      "type": "string",
      "description": "Company name from the posting"
    },
    "role": {
      "type": "string",
      "description": "Job title or role name"
    },
    "posting_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the job posting"
    },
    "is_match": {
      "type": "boolean",
      "description": "True if the posting is a strong match for the applicant"
    },
    "relevance_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Concise evidence for each direct match (required when is_match is true)"
    },
    "decline_reason": {
      "type": "string",
      "description": "Short reason when is_match is false"
    }
  },
  "additionalProperties": false
}
