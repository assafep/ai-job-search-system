{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/internal/workflow-schedule",
      "schedule": "0 5 * * *"
    }
  ]
}
