[Unit]
Description=AJSS ChatGPT workflow worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -u -m services.chat_workflow_worker
EnvironmentFile=@REPO@/.onboarding/application-service.env
Environment="PATH=@PATH@"
Environment="WORKLOAD_REGISTRY_PATH=@REPO@/config/workloads.json"
Environment="APPROVAL_REGISTRY_PATH=@REPO@/config/approvals.json"
Environment="CODING_AGENT=@CODING_AGENT@"
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=default.target
